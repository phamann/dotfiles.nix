default_mode "normal"

copy_command "pbcopy"

keybinds {
    shared_except "locked" {
        // Key names are case-sensitive: "Alt T" would only match Alt+Shift+t.
        bind "Alt t" { NewTab; }
        // "Zoom" the focused pane, as tmux's prefix+z (default is Ctrl p, f).
        // Alt x shadows zsh's execute-named-cmd.
        bind "Alt z" "Alt x" { ToggleFocusFullscreen; }
        // New floating shell at a set size. There's no global default for
        // floating pane size; Alt f (show/hide) still creates zellij's
        // built-in size when no floating pane exists.
        bind "Alt w" {
            Run "zsh" {
                floating true
                close_on_exit true
                width "80%"
                height "80%"
                x "10%"
                y "10%"
            }
        }

        // Not bound by default (digits only switch tabs inside Tab mode).
        // Without these, Alt+digit falls through to zsh as a repeat count.
        bind "Alt 1" { GoToTab 1; }
        bind "Alt 2" { GoToTab 2; }
        bind "Alt 3" { GoToTab 3; }
        bind "Alt 4" { GoToTab 4; }
        bind "Alt 5" { GoToTab 5; }
        bind "Alt 6" { GoToTab 6; }
        bind "Alt 7" { GoToTab 7; }
        bind "Alt 8" { GoToTab 8; }
        bind "Alt 9" { GoToTab 9; }

        // Trial: mirror the default Alt+arrow focus binds on Ctrl+Alt, since
        // Raycast owns Alt+arrow system-wide for window snapping.
        bind "Ctrl Alt Left" { MoveFocusOrTab "Left"; }
        bind "Ctrl Alt Right" { MoveFocusOrTab "Right"; }
        bind "Ctrl Alt Up" { MoveFocus "Up"; }
        bind "Ctrl Alt Down" { MoveFocus "Down"; }
    }
}

plugins {
    tab-bar { path "tab-bar"; }
    status-bar { path "status-bar"; }
    strider { path "strider"; }
    compact-bar { path "compact-bar"; }
    session-manager { path "session-manager"; }
}

// Choose what to do when zellij receives SIGTERM, SIGINT, SIGQUIT or SIGHUP
// eg. when terminal window with an active zellij session is closed
// Options:
//   - detach (Default)
//   - quit
//
// on_force_close "quit"

simplified_ui true
// Frames are drawn in a faint bgAlt (modules/zellij/default.nix): a subtle
// line plus a 1-cell gutter around each pane.
pane_frames true
default_layout "@layout@"

ui {
    pane_frames {
        hide_session_name true
    }
}

// Active theme. Stylix writes ~/.config/zellij/themes/stylix.kdl
// (modules/theme/default.nix sets stylix.base16Scheme; modules/zellij sets
// stylix.targets.zellij.enable), but the theme *inside* that file is named
// "default" — zellij resolves themes by node name, not filename. An unknown
// name silently falls back to the built-in palette (black bars).
theme "default"

copy_on_select false

env {
 TERM "xterm-256color"
}
